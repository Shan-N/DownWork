# Ignore node_modules
node_modules
**/node_modules

# Ignore build output
.next
out

# Ignore logs
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log
*.log

# Ignore test files and coverage
coverage
*.test.js
*.test.ts
*.spec.js
*.spec.ts
jest.config.js
__tests__/
__mocks__/

# Ignore environment files (if passing at runtime)
.env
.env.local
.env.*.local
.env.production

# Ignore editor settings
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore git files
.git
.gitignore

# Ignore Docker-related
Dockerfile.dev
docker-compose.yml
docker-compose.override.yml
